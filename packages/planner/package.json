{
  "name": "@tupl/planner",
  "version": "0.8.0",
  "description": "SQL parsing, lowering, and physical planning for tupl",
  "homepage": "https://github.com/AndrewIngram/tupl/tree/main/packages/planner#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewIngram/tupl.git",
    "directory": "packages/planner"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@tupl/foundation": "workspace:*",
    "@tupl/provider-kit": "workspace:*",
    "@tupl/schema-model": "workspace:*",
    "better-result": "catalog:"
  }
}
