{
  "name": "@tupl/runtime",
  "version": "0.8.0",
  "description": "Query execution, guardrails, and sessions for tupl",
  "homepage": "https://github.com/AndrewIngram/tupl/tree/main/packages/runtime#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewIngram/tupl.git",
    "directory": "packages/runtime"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./executor": {
      "source": "./src/runtime/executor.ts",
      "import": {
        "types": "./dist/executor.d.mts",
        "default": "./dist/executor.mjs"
      },
      "require": {
        "types": "./dist/executor.d.cts",
        "default": "./dist/executor.cjs"
      }
    },
    "./session": {
      "source": "./src/runtime/session/index.ts",
      "import": {
        "types": "./dist/session.d.mts",
        "default": "./dist/session.mjs"
      },
      "require": {
        "types": "./dist/session.d.cts",
        "default": "./dist/session.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@tupl/foundation": "workspace:*",
    "@tupl/planner": "workspace:*",
    "@tupl/provider-kit": "workspace:*",
    "@tupl/schema-model": "workspace:*",
    "better-result": "catalog:"
  }
}
