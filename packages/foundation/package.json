{
  "name": "@tupl/foundation",
  "version": "0.8.0",
  "description": "Foundational relational model, diagnostics, and value utilities for tupl",
  "homepage": "https://github.com/AndrewIngram/tupl/tree/main/packages/foundation#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewIngram/tupl.git",
    "directory": "packages/foundation"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  }
}
