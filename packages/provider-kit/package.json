{
  "name": "@tupl/provider-kit",
  "version": "0.8.0",
  "description": "Provider contracts, entity binding, and shape helpers for tupl adapters",
  "homepage": "https://github.com/AndrewIngram/tupl/tree/main/packages/provider-kit#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewIngram/tupl.git",
    "directory": "packages/provider-kit"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./relational-sql": {
      "source": "./src/relational-sql.ts",
      "types": "./dist/relational-sql.d.mts",
      "import": "./dist/relational-sql.mjs"
    },
    "./shapes": {
      "source": "./src/provider/shapes/index.ts",
      "types": "./dist/shapes.d.mts",
      "import": "./dist/shapes.mjs"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@tupl/foundation": "workspace:*",
    "better-result": "catalog:"
  }
}
